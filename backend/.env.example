# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://conectia:conectia@localhost:5432/conectia
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false
# Set DB_SSL_REJECT_UNAUTHORIZED=false ONLY for self-signed certs in local/staging
# NEVER set this to false in production — use a trusted CA instead
# DB_SSL_REJECT_UNAUTHORIZED=true

# ─── Firebase Admin ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=conectia-ebb79
# For production (service account JSON):
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@conectia-ebb79.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Wompi Payment Gateway ──────────────────────────────────────────────────────
# ALL THREE are REQUIRED — use sandbox credentials in development:
# https://docs.wompi.co/docs/en/testing
#
# Sandbox public key starts with "pub_stagtest_"
WOMPI_PUBLIC_KEY=pub_stagtest_REPLACE_ME
# Found in Wompi dashboard → Developers → Events → Secret key
WOMPI_EVENTS_SECRET=stagtest_events_secret_REPLACE_ME
# Found in Wompi dashboard → Developers → Integrity → Secret key
WOMPI_INTEGRITY_SECRET=stagtest_integrity_secret_REPLACE_ME

# ─── Platform Internal Secrets (Conectia) ───────────────────────────────────────
# Generate with: openssl rand -hex 32
# Guards tenant creation and plan activation endpoints
PLATFORM_API_KEY=dev_platform_key_replace_this_with_openssl_rand_hex_32

# ─── Cron Secret ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Sent by Railway/Render/Vercel Cron as X-Cron-Secret header
CRON_SECRET=dev_cron_secret_replace_this_with_openssl_rand_hex_32_characters

# ─── App URLs ────────────────────────────────────────────────────────────────────
# Public URL of this app — used in payment redirect links sent to residents
# APP_URL=https://app.conectia.co

# ─── Logging & CORS ──────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Restrict to your admin domain in production: https://admin.conectia.co
CORS_ORIGIN=*
